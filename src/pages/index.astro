---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Sidenote from '../components/Sidenote.astro';
import Socials from '../components/Socials.astro';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }).toLowerCase();
---

<Base
  title="shwetank shrey"
  description="full-stack systems engineer who happens to be unusually comfortable down at silicon. cortex band at ultrahuman, tweek labs before that."
>
  <section class="hero">
    <div class="hero-text">
      <h1 class="h1-name">shwe<span class="accent">tank</span> shrey</h1>
      <p class="tagline">
        full-stack systems engineer who happens to be unusually comfortable down at silicon.
      </p>
    </div>
    <div class="portrait-col">
      <div class="portrait-frame">
        <img
          class="portrait"
          src="/portrait.webp"
          alt="shwetank shrey, sunrise over yangshuo"
          width="260"
          height="260"
          fetchpriority="high"
        />
      </div>
      <p class="portrait-caption">yangshuo · sunrise</p>
    </div>
  </section>

  <section class="prose">
    <p class="prose-body">
      most recently led r&amp;d on cortex band at ultrahuman — built a custom
      electromyography<a href="#sn-1" class="fn" id="fnref-1">1</a> wrist sensor from scratch
      and integrated it into a modular passive activity tracker. developed novel
      neuromuscular biomarkers from the signal: muscle activation, fatigue, grip age.
    </p>
    <Sidenote n="1">
      <span id="sn-1">electromyography reads the electrical activity of muscle contractions
      off the skin. notoriously noisy on a moving wrist; the wearable problem is making
      it stable across hours.</span>
    </Sidenote>

    <p class="prose-body">
      before that, co-founded tweek labs (cto) — built a wearable motion capture suit
      and the real-time analytics platform that analyzed athlete performance from its
      data. used by professional teams; recorded over 10,000 athletes. acquired by
      ultrahuman in 2024.
    </p>

    <p class="season">
      this season: writing, decompressing from a hardware ship, and starting to look
      around for the next deep-tech systems problem to put hands on.
    </p>
  </section>

  <hr />

  <h2 class="label">essays</h2>
  <p class="prose-body">
    i've worked across enough of the stack — hardware, firmware, mobile, the systems
    and sourcing behind them — to have opinions on most of it. drafts in progress.
  </p>
  {
    essays.length > 0 && (
      <ul class="essay-list home-essays">
        {essays.map((entry) => (
          <li class="essay-row">
            <p class="essay-date">{fmtDate(entry.data.date)}</p>
            <h3 class="essay-title">
              <a href={`/essays/${entry.id}`}>{entry.data.title}</a>
            </h3>
            {entry.data.deck && <p class="essay-deck">{entry.data.deck}</p>}
          </li>
        ))}
      </ul>
    )
  }

  <hr />

  <h2 class="label">elsewhere</h2>
  <Socials />
</Base>
