---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, deck, date } = entry.data;

const dateLabel = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }).toLowerCase();
---

<Base title={`${title} — tank`} description={deck}>
  <article class="long-prose">
    <p class="kicker">{dateLabel}</p>
    <h1>{title}</h1>
    {deck && <p class="essay-deck" style="margin-bottom: 2rem;">{deck}</p>}
    <Content />
  </article>
</Base>
