---
const path = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
};
---

<header class="masthead">
  <a href="/" class="wordmark">tank</a>
  <nav class="nav" aria-label="primary">
    <a href="/essays" aria-current={isCurrent('/essays') ? 'page' : undefined}>essays</a>
    <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>about</a>
    <a href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>contact</a>
  </nav>
</header>
