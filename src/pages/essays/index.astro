---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }).toLowerCase();
---

<Base
  title="essays — tank"
  description="essays by shwetank shrey on hardware lifecycles, shenzhen sourcing, patents, ai-for-hardware, and generalist engineering."
>
  <article class="long-prose">
    <h1>essays</h1>
    <p>
      i've worked across enough of the stack — hardware, firmware, mobile,
      the systems and sourcing behind them — to have opinions on most of it.
      drafts in progress.
    </p>
  </article>

  {
    essays.length > 0 && (
      <section class="essay-list-wrap">
        <ul class="essay-list">
          {essays.map((entry) => (
            <li class="essay-row">
              <p class="essay-date">{fmtDate(entry.data.date)}</p>
              <h2 class="essay-title">
                <a href={`/essays/${entry.id}`}>{entry.data.title}</a>
              </h2>
              {entry.data.deck && <p class="essay-deck">{entry.data.deck}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
