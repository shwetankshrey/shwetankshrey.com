---
const links = [
  { label: 'github', href: 'https://github.com/shwetankshrey', handle: '@shwetankshrey' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/shwetankshrey', handle: '/in/shwetankshrey' },
  { label: 'x', href: 'https://x.com/shwetankshrey', handle: '@shwetankshrey' },
  { label: 'email', href: 'mailto:tank@shwetankshrey.com', handle: 'tank@shwetankshrey.com' },
];
---

<ul class="elsewhere">
  {
    links.map(({ label, href, handle }) => (
      <li>
        <a href={href}>
          {label}
          <span class="handle">{handle}</span>
        </a>
      </li>
    ))
  }
</ul>
